{{!
    @template local_learnwise/courses

    Add / Remove Courses

    Example context (json):
    {
      "pageurl": "/local/learnwise/courses.php",
      "sesskey": "4",
      "currenthtml": "<select id=\"existingcourses\" name=\"existingcourses[]\" multiple>\n  <option value=\"1\">Course A</option>\n  <option value=\"2\">Course B</option>\n</select>",
      "potentialhtml": "<select id=\"potentialcourses\" name=\"potentialcourses[]\" multiple>\n  <option value=\"3\">Course C</option>\n  <option value=\"4\">Course D</option>\n</select>",
      "larrow": "&larr;",
      "add_label": "Add",
      "remove_label": "Remove",
      "rarrow": "&rarr;"
    }
}}

<form id="assignform" method="post" action="{{pageurl}}">
    <div>
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <table class="generaltable generalbox boxaligncenter groupmanagementtable">
            <tr style="display: flex;">
                <td id="existingcell">
                    {{{currenthtml}}}
                </td>
                <td id="buttonscell" class="text-center">
                    <div id="addcontrols">
                        <input class="btn btn-secondary" name="addcourses" id="addcourses" type="button" value="{{{larrow}}} {{add_label}}" title="{{add_label}}">
                        <br>
                    </div>

                    <div id="removecontrols" class="text-center">
                        <input class="btn btn-secondary" name="removecourses" id="removecourses" type="button" value="{{remove_label}} {{{rarrow}}}" title="{{remove_label}}">
                    </div>
                </td>
                <td id="potentialcell">
                    {{{potentialhtml}}}
                </td>
            </tr>
        </table>
    </div>
</form>
